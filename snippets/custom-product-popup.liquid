<div class="product-popup" id="product-popup">
  <div class="product-popup__overlay"></div>
  <div class="product-popup__content">
    <button class="product-popup__close">
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
        <path d="M4.24219 4.24285L12.7275 12.7281" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
        <path d="M4.24219 12.7277L12.7275 4.24243" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="product-popup__inner">
      <div class="product-popup__image-title">
        <div class="product-popup__image">
          <img id="popup-image" width="120" height="140" src="" alt="">
        </div>
        <div class="product-popup__info">
          <h2 id="popup-title"></h2>
          <div id="popup-price"></div>
          <div id="popup-description"></div>
        </div>
      </div>
      <div class="popup-options">
        <div class="popup-option-group">
          <label>Color</label>
          <div id="color-options"></div>
        </div>
        <div class="popup-option-group">
          <label>Size</label>
          <div class="custom-select-wrapper">
            <div class="custom-select-trigger">
              <span>Select Size</span>
              <span class="custom-arrow">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="9" viewBox="0 0 15 9" fill="none">
                  <path d="M1.06067 1.06067L7.06067 7.06067L13.0607 1.06067" stroke="black" stroke-width="1.5" stroke-linecap="square"/>
                </svg>
              </span>
            </div>
            <div class="custom-options" id="size-options"></div>
          </div>
          {% comment %}
            <select id="size-options">
              <option value="">Choose your size</option>
            </select>
          {% endcomment %}
        </div>
      </div>
      <button id="popup-add-to-cart">
        ADD TO CART
         <svg xmlns="http://www.w3.org/2000/svg" width="26" height="12" viewBox="0 0 26 12" fill="none">
        <path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
    </svg>
      </button>
    </div>
  </div>
</div>
