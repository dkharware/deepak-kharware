<section class="cusom-banner">

<div class="Custom-NavBar">
  {% if section.settings.brandName != blank %}
    <div class="NavBar-BrandTitle">
      {{ section.settings.brandName }}
    </div>
  {%  endif %}  
  {% if section.settings.Announcement != blank %}
    <div class="NavBar-Announcement_Text">
      {{ section.settings.Announcement }}
    </div>
  {%  endif %}  
  {% if section.settings.button_text-header != blank %}
    <a href="{{ section.settings.button_link_header }}" class="NavBar-button_text">
      {{ section.settings.button_text-header }}
    </a>
  {%  endif %}  
</div>    

<div class="custom-banner__content page-width">
    {% if section.settings.heading != blank  %}
    <h1 class="custom-banner__heading"> 
        {{ section.settings.heading }}
    </h1>
    {%  endif %} 

    {%  if section.settings.subheading != blank %}
        <p class="custom-banner___text">
            {{ section.settings.subheading  }}
        </p>
    {%  endif  %}

    {%  if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="custom-banner___button">
            {{ section.settings.button_text  }}
            <svg xmlns="http://www.w3.org/2000/svg" width="27" height="12" viewBox="0 0 27 12" fill="none">
               <path d="M0.75 4.77295L7.83954e-08 4.77295L-7.83954e-08 6.27295L0.75 6.27295L0.75 4.77295ZM26.7876 6.05328C27.0805 5.76039 27.0805 5.28551 26.7876 4.99262L22.0146 0.21965C21.7217 -0.0732435 21.2468 -0.0732435 20.9539 0.21965C20.6611 0.512543 20.6611 0.987417 20.9539 1.28031L25.1966 5.52295L20.9539 9.76559C20.6611 10.0585 20.6611 10.5334 20.9539 10.8263C21.2468 11.1191 21.7217 11.1191 22.0146 10.8263L26.7876 6.05328ZM0.75 6.27295L26.2572 6.27295L26.2572 4.77295L0.75 4.77295L0.75 6.27295Z" fill="white"/>
            </svg>
        </a>
    {%  endif  %}
</div>

    {%  if section.settings.image != blank %}
        <div  class="custom-banner___image">
            {{ section.settings.image 
                | image_url: width: 1600 
                | image_tag }}
        </div>
    {%  endif  %}
</section>

{% schema %}
{
    "name": "Custom Banner",
    "settings": [
        {
            "type": "header",
            "content": "Banner Header"
        },
        {
            "type": "text",
            "id": "brandName",
            "label": "Brand Name"
        },
        {
            "type": "textarea",
            "id": "Announcement",
            "label": "Announcement Text"
        },
        {
            "type": "text",
            "id": "button_text-header",
            "label": "Button Text Header"
        },
        {
            "type": "url",
            "id": "button_link_header",
            "label": "Button Link Header"
        },
        {
            "type": "header",
            "content": "Banner Content"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading"
        },
        {
            "type": "textarea",
            "id": "subheading",
            "label": "Subheading"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Text"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Banner Image"
        }
        
    ],
    "presets": [
        {
            "name": "Custom Banner"
        }
    ]
}
{%  endschema %}