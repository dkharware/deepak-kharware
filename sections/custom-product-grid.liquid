<section class="custom-grid page-width">
    <div class="custom-grid_wrapper"> 
        {%  for block in section.blocks %}
        {% assign product = block.settings.product %}

            {%  if product != blank %}
               <div  class="custom-grid_item" data-product='{{ product | json | escape }}' > 
                    <div class="custom-grid__image"> 
                        {{ product.featured_image | image_url: width: 600 | image_tag }}  
                    </div>
                    {% comment %} <h3 class="custom-grid__title">
                        {{ product.title }}
                    </h3> {% endcomment %}
                   <button class="custon-grid__button js-open-popup" >+</button>

                </div>
            {% endif %}
            
        {% endfor %}    
    </div>
 
    {% comment %} Popup {% endcomment %}

    <div class="product-popup" id="product-popup">
        <div product-popup__overlay></div> 
        <div class="product-popup__content">
            <button class="product-popup__close">
                X
            </button>
            <div class="product-popup__inner">
                <div class="product-popup__image" >
                    <img id="popup-image" width="120" height="140" src="" alt="">
                </div>
            </div>    
        </div>
    </div>

</section> 
{% schema %}
{
    "name": "product",
    "blocks": [
        {
            "type": "product",
            "name": "product",
            "settings": [
                {
                    "type": "product",
                    "id":"product",
                    "label": "Select Product",


                }
            ],
            
        }
    ],
    "max_blocks": 6,
    "presets": [
        {
            "name": "Custom Product Grid"
        }
    ]
}
{% endschema %}