<section class="custom-grid page-width">
    <div class="custom-grid_wrapper"> 
        {%  for blocks in section.blocks %}
         {% assign product = block.settings.product %}

        {% endfor %}    
    </div>
</section> 
{% schema %}
{
    "name": "product",
    "blocks": [
        {
            "type": "product",
            "name": "product",
            "settings": [
                {
                    "type": "product",
                    "id":"product",
                    "label": "Select Product",


                }
            ],
            
        }
    ],
    "max_blocks": 6,
    "presets": [
        {
            "name": "Custom Product Grid"
        }
    ]
}
{% endschema %}